APP_NAME=CampusMatch
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./campusmatch.db
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
SEED_DEMO_DATA=true
MATCHING_TIMEZONE=Asia/Shanghai
WEEKLY_MATCHING_WEEKDAY=5
WEEKLY_MATCHING_BATCH_HOURS=10,11,13
WEEKLY_MATCHING_BATCH_MINUTE=0
WEEKLY_RECOMMENDATION_COUNT=3

# Deep matching. When DASHSCOPE_API_KEY is empty, matching safely falls back to rule scores.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEP_MATCH_CANDIDATE_POOL_SIZE=10
DEEP_MATCH_MAX_WEEKLY_CALLS=10
DEEP_MATCH_PRELIMINARY_WEIGHT=0.4
DEEP_MATCH_MODEL_WEIGHT=0.6
DEEP_MATCH_TIMEOUT_SECONDS=45

# Repeat-pair ranking penalties. These lower selection priority without changing the displayed compatibility score.
REPEAT_MATCH_RECENT_WINDOW_DAYS=30
REPEAT_MATCH_RECENT_PENALTY=30
REPEAT_MATCH_MEDIUM_WINDOW_DAYS=90
REPEAT_MATCH_MEDIUM_PENALTY=15
REPEAT_MATCH_LONG_WINDOW_DAYS=180
REPEAT_MATCH_LONG_PENALTY=5

# Optional SMTP configuration. Email notifications are skipped when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@campusmatch.local
SMTP_START_TLS=true
